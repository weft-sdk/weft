// The contract every conformance case reads. It is not a model of good design: it has one of
// everything, so that a case can pin down exactly one behaviour.
package conformance @version("1.0.0")

enum Currency { EUR GBP USD }

enum Side { Left Right }

type Money {
  amount: int
  currency: Currency
}

type Line {
  sku: string
  qty: int32 @min(1) @max(100)
}

type Page<T> {
  items: T[]
  next?: string
}

type Pair<A, B> {
  first: A
  second: B
}

/// One field of each primitive, all required.
type Primitives {
  s: string
  b: bool
  i: int
  i32: int32
  i64: int64
  f: float
  f32: float32
  f64: float64
  d: decimal
  u: uuid
  t: timestamp
  by: bytes
}

/// Optional fields and wire names.
type Profile {
  id: uuid
  displayName: string @wire("display_name")
  nickname?: string
  age?: int32
  tags?: string[]
}

/// Nested records, lists and maps.
type Order {
  id: uuid
  customer: string @length(1, 20)
  lines: Line[]
  total: Money
  sides: map<Side, int>
  labels: map<string, string[]>
  note?: string
  placedAt: timestamp
}

/// One rule per type, so a case pins down one rule.
type MinMax {
  n: int @min(10) @max(20)
}

type FloatRange {
  r: float @min(0.5) @max(1.5)
}

type DecimalRange {
  d: decimal @min(0) @max(100)
}

type NameLength {
  s: string @length(2, 5)
}

type Anchored {
  s: string @pattern("^[A-Z]{3}-[0-9]+$")
}

type Unanchored {
  s: string @pattern("[0-9]+")
}

type EmailOnly {
  s: string @format(email)
}

type UrlOnly {
  s: string @format(url)
}

type UriOnly {
  s: string @format(uri)
}

type HostnameOnly {
  s: string @format(hostname)
}

type Ipv4Only {
  s: string @format(ipv4)
}

type Ipv6Only {
  s: string @format(ipv6)
}

type DateOnly {
  s: string @format(date)
}

type TimeOnly {
  s: string @format(time)
}

type ListLength {
  items: int[] @length(1, 3)
}

type BlobLength {
  blob: bytes @length(2, 4)
}

type DictLength {
  dict: map<string, int> @length(1, 2)
}

type Empty {}

event order.placed: Order {
  key: id
}

event order.cancelled: { id: uuid, reason: string }

error OutOfStock @status(409) {
  sku: string
  available: int
}
