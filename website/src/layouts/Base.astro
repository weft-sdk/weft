---
import Logo from "../components/Logo.astro";
import Footer from "../components/Footer.astro";
// Preload the Latin font files so text never renders first in a fallback font.
import geistUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMonoUrl from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Declared here, inline in <head>, so the fonts are known before the first paint in dev and in builds.
// Latin only: the site is in English. Characters outside it fall back to system fonts.
const fontFaces = [
  ["Geist Variable", geistUrl],
  ["Geist Mono Variable", geistMonoUrl],
]
  .map(
    ([family, url]) =>
      `@font-face{font-family:"${family}";font-style:normal;font-display:swap;font-weight:100 900;src:url(${url}) format("woff2-variations"),url(${url}) format("woff2");}`,
  )
  .join("");

const nav = [
  { href: "/#transports", label: "transports" },
  { href: "/#compare", label: "compare" },
  { href: "/#languages", label: "languages" },
  { href: "/#dashboard", label: "dashboard" },
  { href: "/docs", label: "docs" },
];
const inDocs = Astro.url.pathname.startsWith("/docs");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces} />
    <script is:inline>
      // Apply a saved theme before first paint so the page never flashes the other theme.
      try {
        const saved = localStorage.getItem("weft-theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <header class="wrap top">
      <a class="mark" href="/" aria-label="Weft home"><Logo size={22} />weft</a>
      <nav class="links" aria-label="Primary">
        {nav.map((item) => <a href={item.href} aria-current={inDocs && item.href === "/docs" ? "page" : undefined}>{item.label}</a>)}
      </nav>
      <div class="actions">
        <button type="button" class="theme" id="theme-toggle" aria-label="Switch between light and dark theme" title="Switch theme">
        <svg class="to-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <svg class="to-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
      </button>
        <a class="cta" href="/#get-started">Get started</a>
        <button type="button" class="burger" id="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="menu">
          <span></span><span></span>
        </button>
      </div>
      <nav class="menu" id="menu" aria-label="Menu" hidden>
        {nav.map((item) => <a href={item.href} aria-current={inDocs && item.href === "/docs" ? "page" : undefined}>{item.label}</a>)}
        <a class="cta" href="/#get-started">Get started</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // The button's label is chosen by CSS from the theme, so nothing changes after first paint.
      const root = document.documentElement;
      const button = document.getElementById("theme-toggle");

      function isLight(): boolean {
        const chosen = root.dataset.theme;
        if (chosen) return chosen === "light";
        return window.matchMedia("(prefers-color-scheme: light)").matches;
      }

      // The phone menu: a button that opens a panel under the bar. It closes on a link, Escape or a wider screen.
      const burger = document.getElementById("menu-toggle");
      const menu = document.getElementById("menu");

      function setMenu(open: boolean): void {
        if (!burger || !menu) return;
        menu.hidden = !open;
        burger.setAttribute("aria-expanded", String(open));
      }

      burger?.addEventListener("click", () => setMenu(menu?.hidden === true));
      menu?.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) setMenu(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu && menu.hidden === false) {
          setMenu(false);
          burger?.focus();
        }
      });
      window.matchMedia("(min-width: 901px)").addEventListener("change", (event) => {
        if (event.matches) setMenu(false);
      });

      button?.addEventListener("click", () => {
        const next = isLight() ? "dark" : "light";
        root.dataset.theme = next;
        try {
          localStorage.setItem("weft-theme", next);
        } catch {}
      });
    </script>
  </body>
</html>

<style is:global>
  /* Imported here, not in the frontmatter: the dev server inlines component styles in <head>,
     but injects frontmatter CSS imports with JavaScript, which flashes an unstyled page. */
  @import "../styles/global.css";
</style>

<style>
  .skip:focus {
    position: fixed;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    z-index: 50;
    padding: 8px 12px;
    background: var(--accent);
    color: var(--on-accent);
  }

  /* The navbar stays pinned to the top while you scroll. The band behind the notch on phones is painted too. */
  .top {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--bg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-base);
    color: var(--muted);
  }

  .mark {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    font-weight: 700;
    font-size: var(--text-lg);
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: 28px;
  }

  nav a {
    text-decoration: none;
  }

  nav a[aria-current="page"],
  .links a:hover,
  .menu a:hover {
    color: var(--fg);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* The one accent control in the bar. */
  .cta {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding-inline: 14px;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: opacity var(--t-fast) ease;
  }

  .cta:hover {
    opacity: 0.88;
  }

  nav .cta:hover {
    color: var(--on-accent);
  }

  .burger {
    appearance: none;
    display: none;
    position: relative;
    width: 34px;
    height: 34px;
    padding: 0;
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--muted);
    cursor: pointer;
    transition: border-color var(--t-fast) ease;
  }

  .burger:hover {
    border-color: var(--line-hover);
    color: var(--fg);
  }

  /* Two bars that cross into an X when the menu is open. */
  .burger span {
    position: absolute;
    left: 9px;
    right: 9px;
    height: 1.5px;
    background: currentColor;
    transition:
      transform var(--t-fast) ease,
      top var(--t-fast) ease;
  }

  .burger span:first-child {
    top: 12px;
  }

  .burger span:last-child {
    top: 20px;
  }

  .burger[aria-expanded="true"] span:first-child {
    top: 16px;
    transform: rotate(45deg);
  }

  .burger[aria-expanded="true"] span:last-child {
    top: 16px;
    transform: rotate(-45deg);
  }

  .menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 12px var(--gutter-r) 20px var(--gutter-l);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .menu[hidden] {
    display: none;
  }

  .menu a:not(.cta) {
    display: block;
    padding-block: 10px;
    font-size: var(--text-md);
  }

  .menu .cta {
    margin-top: 12px;
  }

  .theme {
    appearance: none;
    background: none;
    border: 0;
    padding: 4px;
    margin: -4px;
    display: flex;
    font: inherit;
    color: var(--muted);
    cursor: pointer;
  }

  .theme:hover {
    color: var(--fg);
  }

  /* Show the theme you would switch to: a sun on the dark theme, a moon on the light one. */
  .to-dark {
    display: none;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .to-light {
      display: none;
    }

    :global(:root:not([data-theme="dark"])) .to-dark {
      display: block;
    }
  }

  :global(:root[data-theme="light"]) .to-light {
    display: none;
  }

  :global(:root[data-theme="light"]) .to-dark {
    display: block;
  }

  @media (max-width: 900px) {
    .links,
    .actions .cta {
      display: none;
    }

    .burger {
      display: block;
    }
  }

  @media (min-width: 901px) {
    .menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta,
    .burger,
    .burger span {
      transition: none;
    }
  }
</style>
