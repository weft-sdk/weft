---
import Section from "./Section.astro";

const phases = [
  { tag: "done", title: "Design", text: "Contract language, API, packages, CLI and architecture.", now: false },
  { tag: "now", title: "Website", text: "This site, then the docs.", now: true },
  { tag: "next", title: "Compiler, TypeScript, Go", text: "Then the shared test suite that checks them against each other.", now: false },
];
---

<Section id="status" command="weft status" label="Status">
  <ol class="status">
    {
      phases.map((p) => (
        <li class:list={{ now: p.now }}>
          <h3><span>{p.tag}</span>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .status {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  li {
    border-top: 2px solid var(--line);
    padding-top: 14px;
  }

  li.now {
    border-top-color: var(--accent);
  }

  h3 {
    margin: 0 0 6px;
    font-size: var(--text-base);
    font-weight: 500;
  }

  h3 span {
    color: var(--faint);
    font-weight: 400;
    margin-right: 10px;
  }

  li.now h3 span {
    color: var(--accent);
  }

  p {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-sans);
  }

  @media (max-width: 900px) {
    .status {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
