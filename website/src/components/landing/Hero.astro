---
import Section from "./Section.astro";
---

<Section id="top" label="Introduction" tight>
  <div class="hero">
    <h1>One interface for every way your services talk.<i class="cursor" aria-hidden="true"></i></h1>
    <p>
      Call <code>weft.http</code>, <code>weft.kafka</code> or <code>weft.ws</code>. Weft runs the library you already
      use underneath, with types from one contract. In development; nothing is published yet.
    </p>
    <div class="act">
      <a class="cta" href="#status">Read the design</a>
      <span class="planned"><span>planned</span>npx @weft-sdk/cli init</span>
    </div>
  </div>
</Section>

<style>
  .hero {
    padding-bottom: clamp(8px, 2vw, 24px);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-hero);
    line-height: 0.94;
    letter-spacing: -0.045em;
    max-width: 15ch;
    text-wrap: balance;
  }

  .cursor {
    display: inline-block;
    width: 0.08em;
    height: 0.8em;
    margin-left: 0.06em;
    vertical-align: -0.04em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  p {
    margin: 28px 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 52ch;
  }

  .act {
    margin-top: 32px;
    display: flex;
    gap: 16px 28px;
    align-items: center;
    flex-wrap: wrap;
  }

  .cta {
    background: var(--accent);
    color: var(--on-accent);
    text-decoration: none;
    padding: 12px 18px;
    font-weight: 500;
    border-radius: var(--radius);
  }

  .cta:hover {
    opacity: 0.9;
  }

  .planned {
    border: 1px solid var(--line);
    padding: 11px 16px;
    display: flex;
    gap: 14px;
    border-radius: var(--radius);
  }

  .planned span {
    color: var(--faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
