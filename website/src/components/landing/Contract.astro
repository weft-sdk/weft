---
/**
 * The contract section. The heading is on the left and the contract on the right, and `weft gen`
 * writes the same type in five equal columns below: TypeScript, Go, Python, Rust and Java.
 * Hovering a column dims the others.
 */
import Section from "./Section.astro";
import Icon from "../Icon.astro";
import Logo from "../Logo.astro";
import { contract, columns } from "../../data/contract";
---

<Section id="contract" label="Contracts">
  <div class="top">
    <div class="text">
      <h2 class="lead">Write the type once. Every service gets it.</h2>
      <p class="intro">
        A contract names each event, route and call with its type. <code>weft gen</code> turns it into typed code with
        the same fields and the same validation, in every service's own language.
      </p>
    </div>

    <div class="src">
      <div class="who">
        <span class="logo"><Logo size={44} /></span>
        <div>
          <div class="name">orders.weft</div>
          <div class="sub">the contract</div>
        </div>
      </div>
      <div class="box">
        <pre class="code">{contract.left.map((line) => <span class="ln" set:html={line} />)}</pre>
        <pre class="code">{contract.right.map((line) => <span class="ln" set:html={line} />)}</pre>
      </div>
    </div>
  </div>

  <div class="drop" aria-hidden="true">
    <span class="gen">weft gen</span>
  </div>

  <div class="cols">
    {
      columns.map((c) => (
        <div class="col">
          <div class="who">
            <span class="logo"><Icon name={c.icon} size={44} brand /></span>
            <div>
              <div class="name">{c.name}</div>
              <div class="sub">{c.sub}</div>
            </div>
          </div>
          <pre class="code box">{c.lines.map((line) => <span class="ln" set:html={line} />)}</pre>
        </div>
      ))
    }
  </div>

  <p class="foot">
    <code>weft gen</code> also writes a typed <code>weft</code> facade, runtime validators and operation metadata for
    every language.
  </p>
</Section>

<style>
  /* Heading and intro on the left, the contract on the right. The contract starts on the rule
     between the second and third language columns below, so the page keeps one grid. */
  .top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    align-items: start;
    margin-bottom: var(--stack-row);
  }

  .text {
    padding-right: 48px;
  }



  .who {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
  }

  .logo {
    display: flex;
    flex: none;
    color: var(--fg);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .code {
    margin: 0;
    padding: 12px 0;
    overflow-x: auto;
    white-space: normal;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: 1.85;
  }

  .code :global(.ln) {
    display: block;
    padding-inline: 12px;
    white-space: pre;
  }

  /* The contract: a strip in two halves. */
  .src {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .box {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .src .code {
    font-size: var(--text-sm);
    padding: 14px 0;
  }

  .src .code + .code {
    border-left: 1px solid var(--line);
  }

  /* The line from the contract down to the generated code, with its label. */
  .drop {
    position: relative;
    height: 56px;
  }

  .drop::before {
    content: "";
    position: absolute;
    left: 70%;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--line);
  }

  .gen {
    position: absolute;
    left: calc(70% + 14px);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  /* Five equal open columns: rules between them, no outer frame. */
  .cols {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 24px 14px 22px;
    min-width: 0;
    transition: opacity var(--t-dim) var(--ease-dim);
  }

  .col:first-child {
    padding-left: 0;
  }

  .col:last-child {
    padding-right: 0;
  }

  .col + .col {
    border-left: 1px solid var(--line);
  }

  /* All five boxes share the height of the tallest, so the row reads evenly. */
  .col .box {
    display: block;
    flex: 1;
  }

  /* Hovering one column softly dims the rest. Colours stay; only brightness changes. */
  @media (hover: hover) {
    .cols:has(.col:hover) .col:not(:hover) {
      opacity: 0.45;
    }
  }

  .foot {
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 28px;
    }

    .text {
      padding-right: 0;
    }

    .drop::before {
      left: 50%;
    }

    .gen {
      left: calc(50% + 14px);
    }

    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .col,
    .col:last-child {
      padding-inline: 0 24px;
      border-bottom: 1px solid var(--line);
    }

    .col + .col {
      border-left: 0;
    }

    .col:nth-child(even) {
      padding-left: 24px;
      padding-right: 0;
      border-left: 1px solid var(--line);
    }

    /* The fifth language sits alone on the last row, full width. */
    .col:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      padding-right: 0;
    }
  }

  @media (max-width: 640px) {
    .box {
      grid-template-columns: minmax(0, 1fr);
    }

    .src .code + .code {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .cols {
      grid-template-columns: minmax(0, 1fr);
    }

    .col,
    .col:nth-child(even) {
      padding-inline: 0;
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .col {
      transition: none;
    }
  }
</style>
