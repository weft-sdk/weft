---
/**
 * The shared-behaviour section: a defaults sheet in three open columns, with a small picture under
 * each default. Values come from docs/sdk-design.md (behaviour and defaults tables).
 */
import Section from "./Section.astro";

type Visual =
  | { kind: "attempts"; count: number; dlq: boolean }
  | { kind: "path"; items: string[]; last?: boolean }
  | { kind: "chips"; items: string[] };

interface Row {
  value: string;
  unit?: string;
  text: string;
  visual: Visual;
}

interface Column {
  title: string;
  sub: string;
  rows: Row[];
}

const columns: Column[] = [
  {
    title: "Messaging",
    sub: "Kafka, RabbitMQ, NATS and the rest",
    rows: [
      {
        value: "5",
        unit: "attempts",
        text: "Retries with exponential backoff and jitter, from 200 ms to 30 s. Then the message is dead-lettered.",
        visual: { kind: "attempts", count: 5, dlq: true },
      },
      {
        value: "At-least-once",
        text: "Delivery is acknowledged after the handler succeeds.",
        visual: { kind: "path", items: ["message", "handler", "ack"], last: true },
      },
      {
        value: "Key",
        text: "Ordering follows the event's declared key.",
        visual: { kind: "chips", items: ["key: id"] },
      },
    ],
  },
  {
    title: "Calls",
    sub: "HTTP, gRPC and typed RPC",
    rows: [
      {
        value: "10 s",
        unit: "timeout",
        text: "Every outgoing call has a deadline, and deadlines propagate across services.",
        visual: { kind: "path", items: ["api", "orders", "payments"] },
      },
      {
        value: "3",
        unit: "attempts",
        text: "Only for Unavailable and Timeout, and only for idempotent operations.",
        visual: { kind: "attempts", count: 3, dlq: false },
      },
      {
        value: "raw",
        text: "Every transport exposes the original client when you need it.",
        visual: { kind: "chips", items: ["weft.http.raw", "weft.kafka.raw"] },
      },
    ],
  },
  {
    title: "Everywhere",
    sub: "Every transport, every language",
    rows: [
      {
        value: "30 s",
        unit: "shutdown",
        text: "In-flight work finishes, offsets commit and connections close.",
        visual: { kind: "path", items: ["stop", "finish", "commit", "close"] },
      },
      {
        value: "CloudEvents",
        unit: "1.0",
        text: "One envelope on every message, in every language.",
        visual: { kind: "chips", items: ["id", "type", "source", "time"] },
      },
      {
        value: "OpenTelemetry",
        text: "Spans and W3C trace context on every transport.",
        visual: { kind: "chips", items: ["Kafka headers", "AMQP properties", "WebSocket messages"] },
      },
    ],
  },
];
---

<Section id="behaviour" label="Shared behaviour">
  <h2 class="lead">The same behaviour on every transport.</h2>
  <p class="intro">
    Each library traces, retries and fails in its own way. Weft does it once, the same way, whether the call is HTTP,
    Kafka or SQS, and whether the service is written in Go or Python.
  </p>

  <div class="cols">
    {
      columns.map((c) => (
        <div class="col">
          <div class="head">
            <h3>{c.title}</h3>
            <span class="sub">{c.sub}</span>
          </div>
          {c.rows.map((r) => (
            <div class="row">
              <div class="value">
                {r.value}
                {r.unit && <small>{r.unit}</small>}
              </div>
              <p class="text">{r.text}</p>
              {r.visual.kind === "attempts" && (
                <div class="attempts" aria-hidden="true">
                  {Array.from({ length: r.visual.count }, () => <span class="sq" />)}
                  {r.visual.dlq && <span class="sq dlq"><i>dlq</i></span>}
                </div>
              )}
              {r.visual.kind === "path" && (
                <div class="path" aria-hidden="true">
                  {r.visual.items.map((item, i, all) => (
                    <>
                      <span class:list={["node", { last: r.visual.kind === "path" && r.visual.last && i === all.length - 1 }]}>{item}</span>
                      {i < all.length - 1 && <span class="arrow">&rarr;</span>}
                    </>
                  ))}
                </div>
              )}
              {r.visual.kind === "chips" && (
                <div class="chips" aria-hidden="true">
                  {r.visual.items.map((item) => <span class="chip">{item}</span>)}
                </div>
              )}
            </div>
          ))}
        </div>
      ))
    }
  </div>
</Section>

<style>

  /* The heading and the caption run the full width, with no forced break. */

  /* The heading and the caption run the full width, with no forced break. */
  .lead {
    max-width: none;
  }

  .intro {
    max-width: none;
    margin-bottom: var(--stack-content);
  }

  /* Three open columns on one grid, so the rows line up across them. */
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(4, auto);
    border-top: 1px solid var(--line);
  }

  .col {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    padding: 0 28px;
    min-width: 0;
  }

  .col:first-child {
    padding-left: 0;
  }

  .col:last-child {
    padding-right: 0;
  }

  .col + .col {
    border-left: 1px solid var(--line);
  }

  .head {
    padding: 24px 0 20px;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .row {
    padding: 20px 0 24px;
    border-top: 1px solid var(--line);
    min-width: 0;
  }

  .value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 2.25rem;
    letter-spacing: -0.04em;
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .value small {
    margin-left: 8px;
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }

  .text {
    margin: 10px 0 0;
    max-width: 40ch;
    font-size: var(--text-base);
    color: var(--muted);
  }

  /* The small picture under each default. */
  .attempts,
  .path,
  .chips {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .sq {
    width: 14px;
    height: 14px;
    background: var(--accent);
    border-radius: 2px;
  }

  .sq.dlq {
    display: inline-flex;
    align-items: center;
    width: auto;
    height: 22px;
    margin-left: 4px;
    padding: 0 9px;
    background: none;
    border: 1px dashed var(--faint);
  }

  .sq.dlq i {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--text-2xs);
    line-height: 1;
    color: var(--muted);
  }

  .node,
  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 3px 9px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--muted);
    white-space: nowrap;
  }

  .node.last {
    color: var(--accent);
    border-color: var(--accent);
  }

  .arrow {
    color: var(--faint);
    font-size: var(--text-xs);
  }

  @media (max-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }

    .col {
      display: block;
      grid-row: auto;
      padding: 0;
      border-bottom: 1px solid var(--line);
    }

    .col + .col {
      border-left: 0;
    }
  }
</style>
