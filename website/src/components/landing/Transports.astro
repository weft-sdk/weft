---
import Section from "./Section.astro";
import Icon from "../Icon.astro";
import { transports } from "../../data/transports";

/** The first library listed is the default; the rest are alternatives. */
const split = (runsOn: string) => {
  const [first = "", ...rest] = runsOn.split(", ");
  return { first, rest: rest.join(", ") };
};
---

<Section id="transports" label="Transports">
  <h2 class="lead">Thirteen transports. One way to call them.</h2>
  <ul class="grid">
    {
      transports.map((t) => {
        const libs = split(t.runsOn);
        return (
          <li class="tile">
            <div class="logo">
              <Icon name={t.icon} size={28} brand />
            </div>
            <div class="title">
              <span class="name">{t.name}</span>
              <code class="ns">
                <span class="pre">weft.</span>
                {t.ns}
              </code>
            </div>
            <div class="libs">
              <span class="first">{libs.first}</span>
              {libs.rest && <span class="rest">{libs.rest}</span>}
            </div>
          </li>
        );
      })
    }
    <li class="tile more">
      <a href="#behaviour">
        <div class="logo">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h10" />
          </svg>
        </div>
        <div class="title">
          <span class="name">Shared behaviour</span>
          <span class="desc">Retries, tracing, timeouts and errors.</span>
        </div>
        <div class="libs">
          <span class="first go">
            See the defaults
            <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </span>
        </div>
      </a>
    </li>
  </ul>
</Section>

<style>

  .lead {
    max-width: none;
    margin-bottom: var(--stack-content);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  /* Every tile has the same three rows: logo, title, libraries. The libraries sit on the bottom edge. */
  .tile,
  .more a {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 20px;
    min-width: 0;
  }

  .tile {
    padding: 24px 22px 20px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: opacity var(--t-dim) var(--ease-dim);
  }

  .more {
    padding: 0;
  }

  .more a {
    height: 100%;
    padding: 24px 22px 20px;
    color: inherit;
    text-decoration: none;
  }

  /* Pointing at one tile softly dims the others. Colours stay; only brightness changes. */
  @media (hover: hover) {
    .grid:has(.tile:hover) .tile:not(:hover) {
      opacity: 0.45;
    }
  }

  .logo {
    height: 28px;
    display: flex;
    align-items: center;
    color: var(--fg);
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .name {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--fg);
    line-height: 1.3;
  }

  .ns {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .ns .pre {
    color: var(--faint);
  }

  .desc {
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.5;
  }

  .libs {
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .first {
    color: var(--fg);
  }

  .rest {
    color: var(--faint);
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
  }

  @media (max-width: 1200px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile {
      transition: none;
    }
  }
</style>
