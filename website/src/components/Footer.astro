---
/**
 * The site footer: the mark and a one-line description, then four columns of grouped links. The
 * Documentation and Transports links are built from src/data/docs.ts, so they match the docs pages.
 */
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { flat } from "../data/docs";

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
  icon?: string;
}
interface Group {
  title: string;
  links: FooterLink[];
}

// The transports are grouped the way the docs group them.
const folderTitles: Record<string, string> = { "request-response": "Request and response", realtime: "Realtime", messaging: "Messaging" };
const transportGroup = (folder: string): Group => ({
  title: folderTitles[folder] ?? folder,
  links: flat.filter((p) => p.section.id === "transports" && p.folder === folder).map((p) => ({ label: p.title, href: p.href })),
});

// Groups are stacked into columns so every column ends at about the same height.
const columns: Group[][] = [
  [transportGroup("request-response"), transportGroup("realtime")],
  [transportGroup("messaging")],
  [
    {
      title: "Documentation",
      links: [
        { label: "Overview", href: "/docs" },
        { label: "Install", href: "/docs/guides/install" },
        { label: "Your first contract", href: "/docs/guides/first-contract" },
        { label: "Contract language", href: "/docs/contracts" },
        { label: "Libraries", href: "/docs/libraries" },
        { label: "CLI reference", href: "/docs/cli" },
        { label: "Migrating existing code", href: "/docs/guides/from-kafkajs" },
      ],
    },
  ],
  [
    {
      title: "Product",
      links: [
        { label: "Transports", href: "/#transports" },
        { label: "Compare", href: "/#compare" },
        { label: "Languages", href: "/#languages" },
        { label: "Dashboard", href: "/#dashboard" },
      ],
    },
    {
      title: "Project",
      links: [
        { label: "GitHub", href: "https://github.com/weft-sdk/weft", external: true, icon: "github" },
        { label: "npm", href: "https://www.npmjs.com/org/weft-sdk", external: true, icon: "npm" },
      ],
    },
  ],
];
---

<footer class="foot">
  <div class="wrap grid">
    <div class="brand">
      <div>
        <a class="mark" href="/" aria-label="Weft home"><Logo size={22} />weft</a>
        <p>One interface for every way your services talk.</p>
      </div>
      <div class="theme" role="group" aria-label="Theme">
        <button type="button" data-theme-choice="system" aria-pressed="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8M12 16v4" /></svg>
          System
        </button>
        <button type="button" data-theme-choice="light" aria-pressed="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          Light
        </button>
        <button type="button" data-theme-choice="dark" aria-pressed="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          Dark
        </button>
      </div>
    </div>
    {
      columns.map((groups) => (
        <div class="col">
          {groups.map((g) => (
            <nav class="group" aria-label={g.title}>
              <h2>{g.title}</h2>
              <ul>
                {g.links.map((l) => (
                  <li>
                    <a href={l.href} {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                      {l.icon && <Icon name={l.icon} size={16} />}
                      {l.label}
                      {l.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
      ))
    }
  </div>
</footer>

<script>
  // The theme selector: System follows the device, Light and Dark are remembered. It stays in step
  // with the navbar's toggle by watching the theme attribute.
  const root = document.documentElement;
  const choices = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]")];

  function current(): string {
    return root.dataset.theme === "light" || root.dataset.theme === "dark" ? root.dataset.theme : "system";
  }

  function sync(): void {
    for (const b of choices) b.setAttribute("aria-pressed", String(b.dataset.themeChoice === current()));
  }

  for (const b of choices) {
    b.addEventListener("click", () => {
      const choice = b.dataset.themeChoice;
      try {
        if (choice === "system") {
          delete root.dataset.theme;
          localStorage.removeItem("weft-theme");
        } else if (choice) {
          root.dataset.theme = choice;
          localStorage.setItem("weft-theme", choice);
        }
      } catch {}
      sync();
    });
  }

  new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
  sync();
</script>

<style>
  .foot {
    border-top: 1px solid var(--line);
  }

  /* Open columns, with a thin rule between them. The rules run the full height of the footer. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) repeat(4, minmax(0, 1fr));
  }

  a {
    text-decoration: none;
  }

  .brand,
  .col {
    padding: var(--section-pad) clamp(20px, 2.5vw, 40px);
  }

  .brand {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding-left: 0;
  }

  /* Three joined buttons; the chosen one is raised. */
  .theme {
    display: inline-flex;
    align-self: flex-start;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .theme button {
    appearance: none;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 14px;
    background: none;
    border: 0;
    color: var(--faint);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      color var(--t-fast) ease,
      background-color var(--t-fast) ease;
  }

  .theme button + button {
    border-left: 1px solid var(--line);
  }

  .theme button:hover {
    color: var(--fg);
  }

  .theme button[aria-pressed="true"] {
    background: var(--raised);
    color: var(--fg);
  }

  .theme button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .col {
    border-left: 1px solid var(--line);
  }

  .group + .group {
    margin-top: 36px;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: var(--text-md);
    letter-spacing: -0.02em;
  }

  .brand p {
    margin: 16px 0 0;
    max-width: 36ch;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  h2 {
    margin: 0 0 16px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .col a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-sm);
    color: var(--muted);
    transition: color var(--t-fast) ease;
  }

  .col a:hover {
    color: var(--fg);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .brand {
      grid-column: 1 / -1;
      padding-bottom: 0;
    }

    .col {
      border-top: 1px solid var(--line);
    }

    .col:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .col,
    .col:nth-child(even) {
      padding: 24px 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .brand {
      padding-bottom: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .col a,
    .theme button {
      transition: none;
    }
  }
</style>
