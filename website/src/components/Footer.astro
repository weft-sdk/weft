---
/**
 * The site footer: the mark and a one-line description, then four columns of grouped links. The
 * Documentation and Transports links are built from src/data/docs.ts, so they match the docs pages.
 */
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { flat } from "../data/docs";

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
  icon?: string;
}
interface Group {
  title: string;
  links: FooterLink[];
}

// The transports are grouped the way the docs group them.
const folderTitles: Record<string, string> = { "request-response": "Request and response", realtime: "Realtime", messaging: "Messaging" };
const transportGroup = (folder: string): Group => ({
  title: folderTitles[folder] ?? folder,
  links: flat.filter((p) => p.section.id === "transports" && p.folder === folder).map((p) => ({ label: p.title, href: p.href })),
});

// Groups are stacked into columns so every column ends at about the same height.
const columns: Group[][] = [
  [transportGroup("request-response"), transportGroup("realtime")],
  [transportGroup("messaging")],
  [
    {
      title: "Documentation",
      links: [
        { label: "Overview", href: "/docs" },
        { label: "Install", href: "/docs/guides/install" },
        { label: "Your first contract", href: "/docs/guides/first-contract" },
        { label: "Contract language", href: "/docs/contracts" },
        { label: "Libraries", href: "/docs/libraries" },
        { label: "CLI reference", href: "/docs/cli" },
        { label: "Migrating existing code", href: "/docs/guides/from-kafkajs" },
      ],
    },
  ],
  [
    {
      title: "Product",
      links: [
        { label: "Transports", href: "/#transports" },
        { label: "Compare", href: "/#compare" },
        { label: "Languages", href: "/#languages" },
        { label: "Dashboard", href: "/#dashboard" },
      ],
    },
    {
      title: "Project",
      links: [
        { label: "GitHub", href: "https://github.com/weft-sdk/weft", external: true, icon: "github" },
        { label: "npm", href: "https://www.npmjs.com/org/weft-sdk", external: true, icon: "npm" },
      ],
    },
  ],
];
---

<footer class="foot">
  <div class="wrap grid">
    <div class="brand">
      <a class="mark" href="/" aria-label="Weft home"><Logo size={22} />weft</a>
      <p>One interface for every way your services talk.</p>
    </div>
    {
      columns.map((groups) => (
        <div class="col">
          {groups.map((g) => (
            <nav class="group" aria-label={g.title}>
              <h2>{g.title}</h2>
              <ul>
                {g.links.map((l) => (
                  <li>
                    <a href={l.href} {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                      {l.icon && <Icon name={l.icon} size={16} />}
                      {l.label}
                      {l.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
      ))
    }
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
  }

  /* Open columns, with a thin rule between them. The rules run the full height of the footer. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) repeat(4, minmax(0, 1fr));
  }

  a {
    text-decoration: none;
  }

  .brand,
  .col {
    padding: var(--section-pad) clamp(20px, 2.5vw, 40px);
  }

  .brand {
    padding-left: 0;
  }

  .col {
    border-left: 1px solid var(--line);
  }

  .group + .group {
    margin-top: 36px;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: var(--text-md);
    letter-spacing: -0.02em;
  }

  .brand p {
    margin: 16px 0 0;
    max-width: 36ch;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  h2 {
    margin: 0 0 16px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .col a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-sm);
    color: var(--muted);
    transition: color var(--t-fast) ease;
  }

  .col a:hover {
    color: var(--fg);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .brand {
      grid-column: 1 / -1;
      padding-bottom: 0;
    }

    .col {
      border-top: 1px solid var(--line);
    }

    .col:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .col,
    .col:nth-child(even) {
      padding: 24px 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .brand {
      padding-bottom: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .col a {
      transition: none;
    }
  }
</style>
