---
/**
 * One icon, drawn in the current text colour.
 * Brand logos come from Simple Icons. Transports without a logo use a line glyph.
 */
import * as simpleIcons from "simple-icons";

const glyphs = {
  http: '<circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/>',
  grpc: '<path d="M4 8h13l-3-3M20 16H7l3 3"/>',
  ws: '<path d="M3 9h15l-3-3M21 15H6l3 3"/>',
  sse: '<path d="M3 7h12M3 12h15M3 17h18l-3-3m3 3-3 3"/>',
  cloud: '<path d="M7 18h10a4 4 0 0 0 .5-7.97A6 6 0 0 0 6.1 10.1 4 4 0 0 0 7 18Z"/>',
  laptop: '<rect x="5" y="5" width="14" height="10" rx="1"/><path d="M3 19h18"/>',
  cluster: '<rect x="4" y="4" width="16" height="6" rx="1"/><rect x="4" y="14" width="16" height="6" rx="1"/><circle cx="8" cy="7" r=".6"/><circle cx="8" cy="17" r=".6"/>',
} as const;

export type Glyph = keyof typeof glyphs;

/**
 * Full-colour logo files in public/logos, used instead of the Simple Icons path when `brand` is set.
 * `dark` is drawn for the dark theme, `light` for the light theme; `src` works on both.
 */
const images: Record<string, { src?: string; dark?: string; light?: string }> = {
  grpc: { src: "/logos/protobuf.webp" },
  ws: { src: "/logos/websocket.webp" },
  cloud: { dark: "/logos/aws-dark.webp", light: "/logos/aws-light.webp" },
  python: { src: "/logos/python.webp" },
  dotnet: { src: "/logos/cs.webp" },
  swift: { src: "/logos/swift.webp" },
  java: { src: "/logos/java.webp" },
};

interface Props {
  /** A Simple Icons slug such as "apachekafka", or a glyph name such as "http". */
  name: string;
  size?: number;
  /** Draw a brand logo in its brand colour. Very dark brand colours fall back to the text colour on the dark theme. */
  brand?: boolean;
}

const { name, size = 16, brand: useBrand = false } = Astro.props;
const key = `si${name.charAt(0).toUpperCase()}${name.slice(1)}` as keyof typeof simpleIcons;
const brand = simpleIcons[key] as { path: string; hex: string } | undefined;

function luminance(hex: string): number {
  const c = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  const [r = 0, g = 0, b = 0] = c.map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}

const image = useBrand ? images[name] : undefined;
const coloured = useBrand && brand !== undefined;
const tooDarkForDark = coloured && luminance(brand.hex) < 0.05;
const style = coloured ? `--brand:#${brand.hex}` : undefined;
const glyph = name in glyphs ? glyphs[name as Glyph] : undefined;
if (!brand && !glyph && !image) throw new Error(`Unknown icon: ${name}`);

---

{
  image ? (
    <span class="img" style={`--s:${size}px`} aria-hidden="true">
      {image.src && <img src={image.src} alt="" loading="lazy" decoding="async" />}
      {image.dark && <img class="on-dark" src={image.dark} alt="" loading="lazy" decoding="async" />}
      {image.light && <img class="on-light" src={image.light} alt="" loading="lazy" decoding="async" />}
    </span>
  ) : brand ? (
    <svg
      class:list={["icon", { brand: coloured, "brand-dark": tooDarkForDark }]}
      style={style}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d={brand.path} />
    </svg>
  ) : (
    <svg
      class="icon"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
      set:html={glyph}
    />
  )
}

<style>
  .icon {
    display: block;
    flex: none;
  }

  .img {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--s);
    flex: none;
  }

  .img img {
    display: block;
    height: 100%;
    width: auto;
    max-width: calc(var(--s) * 1.9);
    object-fit: contain;
  }

  .on-light {
    display: none !important;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .on-light {
      display: block !important;
    }

    :global(:root:not([data-theme="dark"])) .on-dark {
      display: none !important;
    }
  }

  :global(:root[data-theme="light"]) .on-light {
    display: block !important;
  }

  :global(:root[data-theme="light"]) .on-dark {
    display: none !important;
  }

  .brand {
    color: var(--brand);
  }

  /* On the dark theme (the default), near-black brand colours would vanish. */
  .brand-dark {
    color: var(--fg);
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .brand-dark {
      color: var(--brand);
    }
  }

  :global(:root[data-theme="light"]) .brand-dark {
    color: var(--brand);
  }
</style>
