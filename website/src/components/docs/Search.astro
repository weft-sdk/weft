---
/**
 * The docs search: a dialog opened from the search button, with / or Ctrl/Cmd+K. It filters a
 * build-time index of every page and section in the browser, so it needs no server.
 */
import { searchIndex } from "../../data/docs";
---

<dialog id="docs-search" aria-label="Search the docs">
  <form method="dialog" class="box">
    <div class="field">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
      <input id="docs-q" type="text" placeholder="Search the docs" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="docs-results" aria-autocomplete="list" />
      <kbd>esc</kbd>
    </div>
    <ul id="docs-results" role="listbox" aria-label="Results"></ul>
    <p id="docs-empty" class="empty" hidden>Nothing matches that.</p>
  </form>
</dialog>
<script id="docs-index" type="application/json" set:html={JSON.stringify(searchIndex)} />

<script>
  interface Entry {
    title: string;
    text: string;
    where: string;
    href: string;
  }

  const dialog = document.getElementById("docs-search") as HTMLDialogElement | null;
  const input = document.getElementById("docs-q") as HTMLInputElement | null;
  const list = document.getElementById("docs-results");
  const empty = document.getElementById("docs-empty");
  const index: Entry[] = JSON.parse(document.getElementById("docs-index")?.textContent ?? "[]");
  let active = 0;

  function score(e: Entry, words: string[]): number {
    const title = e.title.toLowerCase();
    const rest = `${e.text} ${e.where}`.toLowerCase();
    let total = 0;
    for (const w of words) {
      if (title.startsWith(w)) total += 6;
      else if (title.includes(w)) total += 4;
      else if (rest.includes(w)) total += 1;
      else return 0;
    }
    return total;
  }

  function render(): void {
    if (!list || !input || !empty) return;
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    const rows = (words.length ? index.map((e) => ({ e, s: score(e, words) })).filter((r) => r.s > 0).sort((a, b) => b.s - a.s) : index.filter((e) => e.where === "Section").map((e) => ({ e, s: 1 }))).slice(0, 9);
    active = 0;
    list.replaceChildren(
      ...rows.map(({ e }, i) => {
        const li = document.createElement("li");
        li.role = "option";
        li.id = `docs-r-${i}`;
        li.setAttribute("aria-selected", String(i === 0));
        const a = document.createElement("a");
        a.href = e.href;
        const t = document.createElement("span");
        t.className = "t";
        t.textContent = e.title;
        const w = document.createElement("span");
        w.className = "w";
        w.textContent = e.where;
        a.append(t, w);
        li.append(a);
        return li;
      }),
    );
    empty.hidden = rows.length > 0;
    input.setAttribute("aria-activedescendant", rows.length ? "docs-r-0" : "");
  }

  function move(delta: number): void {
    const items = [...(list?.children ?? [])] as HTMLElement[];
    if (!items.length) return;
    items[active]?.setAttribute("aria-selected", "false");
    active = (active + delta + items.length) % items.length;
    const el = items[active];
    el?.setAttribute("aria-selected", "true");
    el?.scrollIntoView({ block: "nearest" });
    input?.setAttribute("aria-activedescendant", el?.id ?? "");
  }

  function open(): void {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    if (input) input.value = "";
    render();
    input?.focus();
  }

  for (const b of document.querySelectorAll("[data-search]")) b.addEventListener("click", open);
  document.addEventListener("keydown", (event) => {
    const typing = (event.target as HTMLElement).closest("input, textarea, [contenteditable]");
    if ((event.key === "k" && (event.metaKey || event.ctrlKey)) || (event.key === "/" && !typing)) {
      event.preventDefault();
      open();
    }
  });
  input?.addEventListener("input", render);
  input?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown") (event.preventDefault(), move(1));
    else if (event.key === "ArrowUp") (event.preventDefault(), move(-1));
    else if (event.key === "Enter") {
      event.preventDefault();
      (list?.children[active]?.querySelector("a") as HTMLAnchorElement | null)?.click();
    }
  });
  // Clicking the dimmed area closes the dialog.
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  dialog {
    width: min(560px, calc(100vw - 32px));
    margin: 12vh auto auto;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line-hover);
    border-radius: var(--radius);
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
  }

  .box {
    margin: 0;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    height: 52px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
  }

  input {
    flex: 1;
    min-width: 0;
    height: 100%;
    background: none;
    border: 0;
    outline: none;
    font: inherit;
    font-size: var(--text-md);
    color: var(--fg);
  }

  kbd {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 1px 6px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 6px;
    max-height: 50vh;
    overflow-y: auto;
  }

  li a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 10px;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--muted);
  }

  li[aria-selected="true"] a {
    background: var(--raised);
    color: var(--fg);
  }

  .w {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
    white-space: nowrap;
  }

  .empty {
    margin: 0;
    padding: 18px 16px;
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
