{
  "name": "@weft-sdk/core",
  "version": "0.1.0",
  "description": "Weft for TypeScript: the weft.* runtime. Validation and encoding from your contracts, lifecycle, middleware, messaging with retries and dead letters, HTTP calls, OpenTelemetry.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weft-sdk/weft.git",
    "directory": "sdks/typescript/packages/core"
  },
  "homepage": "https://github.com/weft-sdk/weft#readme",
  "bugs": {
    "url": "https://github.com/weft-sdk/weft/issues"
  },
  "keywords": [
    "weft",
    "contracts",
    "kafka",
    "http",
    "opentelemetry",
    "codegen"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@types/node": "26.6.6",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "yaml": "2.9.1"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
